<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp">
    <LinearLayout
        android:id="@+id/llContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/feature_request_bg_button_submit"
        android:orientation="vertical">
<!--        row1-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/set_as_default_bg_item_primary_color"
                android:gravity="center"
                android:text="1"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#040516"
                android:text="Select this WORD Reader icon in the app list."
                tools:text="Select this WORD Reader icon in the app list."
                />
        </LinearLayout>
<!--        row2-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/set_as_default_bg_item_primary_color"
                android:gravity="center"
                android:text="2"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#040516"
                tools:text="Click “Always” to set it as the default reader."
                android:text="Click “Always” to set it as the default reader."
                />
        </LinearLayout>
<!--        row3-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="49dp"
                android:src="@drawable/set_as_default_ic3"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="36dp"
                android:layout_height="43dp"
                android:src="@drawable/set_as_default_ic4"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="36dp"
                android:layout_height="43dp"
                android:src="@drawable/set_as_default_ic4"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="36dp"
                android:layout_height="43dp"
                android:src="@drawable/set_as_default_ic4"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="36dp"
                android:layout_height="43dp"
                android:src="@drawable/set_as_default_ic4"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
        <TextView
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="WORD Reader"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#040516"/>
        <LinearLayout
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Always"
                android:textColor="@color/primaryColor"
                android:textSize="8dp"
                android:gravity="center"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Select WORD Reader icon and click Always to set it as default!"
        android:text="Select WORD Reader icon and click Always to set it as default!"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llContainer"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#040516"
        />
    <TextView
        android:id="@+id/btnConfirm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvContent"
        tools:text="OK"
        android:text="OK"
        android:background="@drawable/feedback_activity_bg_button_send"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>