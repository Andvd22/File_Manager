<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.ClearDefaultGuideActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="16dp"
        android:background="@drawable/set_as_default_bg_act_4">
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/clear_default_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#040516"
            android:gravity="center_horizontal"/>
        <LinearLayout
            android:id="@+id/llContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="10dp"
            android:background="@drawable/set_as_default_bg_item_act_4">
            <!--        row1-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:background="@drawable/set_as_default_bg_item_primary_color"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    />
                <TextView
                    android:id="@+id/tvStep1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#040516"
                    android:text="@string/clear_default_step1"
                    tools:text="@string/clear_default_step1"
                    />
            </LinearLayout>

            <!--        row2-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="15dp">
                <TextView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:background="@drawable/set_as_default_bg_item_primary_color"
                    android:gravity="center"
                    android:text="2"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    />
                <TextView
                    android:id="@+id/tvStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#040516"
                    android:text="@string/clear_default_step2"
                    tools:text="@string/clear_default_step2"
                    />
            </LinearLayout>

            <!--        row3-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="15dp">
                <TextView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:background="@drawable/set_as_default_bg_item_primary_color"
                    android:gravity="center"
                    android:text="3"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    />
                <TextView
                    android:id="@+id/tvStep3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#040516"
                    android:text="@string/clear_default_step3"
                    tools:text="@string/clear_default_step3"
                    />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvBtnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/feedback_activity_bg_button_send"
            android:text="@string/clear_default_cta"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llContainer"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>