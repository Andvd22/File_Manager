<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.RequestNotiActivity"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">
    <TextView
        android:id="@+id/btnLater"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="5dp"
        android:padding="2dp"
        tools:text="@string/common_later"
        android:text="@string/common_later"
        android:textColor="#8C8DAF"
        android:textSize="12sp"/>
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnLater"
        android:layout_marginTop="32dp"
        android:textColor="#040516"
        tools:text="@string/request_noti_title"
        android:text="@string/request_noti_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        android:layout_marginTop="40dp"
        android:id="@+id/clContainer"
        >
        <TextView
            android:layout_width="250dp"
            android:layout_height="211dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/request_noti_bg"
            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:paddingHorizontal="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="horizontal"
            android:background="@drawable/request_noti_bg_item"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="28dp"
                android:src="@drawable/add_feature_ppts"/>

            <LinearLayout
                android:layout_marginStart="11dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="@string/request_noti_sample_title"
                    android:text="@string/request_noti_sample_title"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    tools:text="Transcript_2024_0810.ppt"
                    android:text="Transcript_2024_0810.ppt"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnOpenFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:paddingVertical="6dp"
                android:paddingHorizontal="10dp"
                android:layout_marginStart="11dp"
                android:background="@drawable/feedback_activity_bg_button_send"
                tools:text="@string/request_noti_open_file"
                android:text="@string/request_noti_open_file"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvDesc1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clContainer"
        android:layout_marginTop="20dp"
        android:textColor="#040516"
        tools:text="@string/request_noti_desc_1"
        android:text="@string/request_noti_desc_1"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"/>
    <TextView
        android:id="@+id/tvDesc2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDesc1"
        android:layout_marginTop="8dp"
        android:textColor="#040516"
        tools:text="@string/request_noti_desc_2"
        android:text="@string/request_noti_desc_2"
        android:textSize="14sp"
        android:gravity="center"/>

    <TextView
        android:id="@+id/btnAllow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:background="@drawable/feedback_activity_bg_button_send"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="@string/common_allow"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDesc2"
        tools:text="@string/common_allow" />

</androidx.constraintlayout.widget.ConstraintLayout>